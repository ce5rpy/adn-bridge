# Instance template — one unit per INI: config/adn-bridge-<instance>.ini
#
# Example:
#   sudo make install
#   sudo cp examples/adn-bridge@.service /etc/systemd/system/
#   # INI at /opt/adn-bridge/config/adn-bridge-redchile.ini
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now adn-bridge@redchile.service
#
# journalctl -u adn-bridge@redchile -f
#
# [log] in the INI: `handlers = console` avoids a duplicate timestamp in
# journalctl (systemd already stamps each line); omit `handlers` entirely to
# auto-detect the same thing. For `handlers = file-timed` + `file = ...`,
# rotate with logrotate's postrotate sending SIGHUP (no restart needed):
#   systemctl kill -s HUP adn-bridge@redchile.service

[Unit]
Description=adn-bridge bridge (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=root
Type=simple
Restart=always
RestartSec=3
SyslogIdentifier=adn-bridge-%i
WorkingDirectory=/opt/adn-bridge
ExecStart=/opt/adn-bridge/adn-bridge -c /opt/adn-bridge/config/adn-bridge-%i.ini
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
